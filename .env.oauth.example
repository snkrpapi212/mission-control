# Mission Control OAuth Configuration
# Copy this to .env.local and fill in your credentials

# ============================================
# OAuth Provider Credentials
# ============================================

# MiniMax OAuth
# Get these from MiniMax Developer Portal
MINIMAX_OAUTH_CLIENT_ID=
MINIMAX_OAUTH_CLIENT_SECRET=

# Google OAuth
# Get these from Google Cloud Console
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# GitHub OAuth  
# Get these from GitHub Developer Settings
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ============================================
# Session & Auth
# ============================================

# Required: Random secret for JWT signing
NEXTAUTH_SECRET=your-super-secret-random-string-here

# Required: Your app's base URL
NEXTAUTH_URL=http://localhost:3000

# ============================================
# Convex
# ============================================

NEXT_PUBLIC_CONVEX_URL=

# ============================================
# Legacy Auth (still used as fallback)
# ============================================

MC_AUTH_ENABLED=true
MC_LOGIN_PASSWORD=
MC_SESSION_TOKEN=
MC_ADMIN_KEY=
